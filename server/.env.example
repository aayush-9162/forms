PORT=7800
# Comma-separated list of frontend origins allowed to call the API.
# In production this MUST be set explicitly.
CORS_ORIGIN=http://localhost:7801,http://localhost:7802

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=forms_portal

# Google Sign-In — the API verifies every Bearer token as a Google ID token.
# GOOGLE_CLIENT_ID must match the frontend VITE_GOOGLE_CLIENT_ID exactly.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Only accept accounts on this domain (e.g. 123cfc.com). Empty = any Google account.
ALLOWED_EMAIL_DOMAIN=

# Upload storage limits
MAX_FILE_MB=10

# --- Google Drive folder IDs ---------------------------------------------
# Drive is used for storing PDFs and image attachments. Drive auth is
# independent of user sign-in (OAuth client in client_secret*.json + token
# in .drive-token.json).
#
# IMAGES: where attachments from forms (delivery checklist, etc.) are uploaded.
# DRIVE_100: where Arden Cash Batch PDFs are uploaded by the afterSubmit hook.
# DRIVE_200: where Waynesville Cash Batch PDFs are uploaded by the afterSubmit hook.
IMAGES=
DRIVE_100=
DRIVE_200=
